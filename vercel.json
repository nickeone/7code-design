{
  "buildCommand": "npm run prebuild && node scripts/validate-schema.mjs && node scripts/check-duplicate-schema.mjs",
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/project/compiled/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/project/bundle.min.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/project/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/project/(.*\\.jsx)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/project/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/project/uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/blog/7code-discovery-mission", "destination": "/blog/ai-discovery-mission-de-risk-ai-products", "statusCode": 301 },
    { "source": "/blog/fixed-price-vs-time-and-materials", "destination": "/blog/ai-engineering-pricing-fixed-vs-time-materials", "statusCode": 301 },
    { "source": "/blog/seamless-software-project-handover", "destination": "/blog/ai-project-handover", "statusCode": 301 },
    { "source": "/blog/changing-software-service-provider", "destination": "/blog/switch-ai-engineering-partner", "statusCode": 301 },
    { "source": "/blog/adrenaline-ai-code-debugger", "destination": "/blog/adrenaline-ai-debugger-case-study", "statusCode": 301 },
    { "source": "/blog/aws-ecs-vs-beanstalk-perspective", "destination": "/blog/aws-beanstalk-to-ecs-migration", "statusCode": 301 },
    { "source": "/:path*", "has": [{ "type": "host", "value": "^(www\\.)?7code\\.ro$" }], "destination": "https://www.7code.tech/:path*", "statusCode": 301 },
    { "source": "/service", "destination": "/services", "statusCode": 301 },
    { "source": "/service/", "destination": "/services", "statusCode": 301 },
    { "source": "/case-study", "destination": "/case-studies", "statusCode": 301 },
    { "source": "/case-study/", "destination": "/case-studies", "statusCode": 301 },
    { "source": "/service/product-strategy", "destination": "/service/ai-product-engineering", "permanent": true },
    { "source": "/blog/", "destination": "/blog", "statusCode": 301 },
    { "source": "/blog-7code/", "destination": "/blog", "permanent": true },
    { "source": "/blog-7code", "destination": "/blog", "permanent": true },
    { "source": "/2025/09/04/7codes-discovery-mission-pioneering-successful-software-development/", "destination": "/blog/ai-discovery-mission-de-risk-ai-products", "permanent": true },
    { "source": "/2025/09/04/7codes-discovery-mission-pioneering-successful-software-development", "destination": "/blog/ai-discovery-mission-de-risk-ai-products", "permanent": true },
    { "source": "/2025/07/03/from-cluj-to-london-what-we-brought-home-from-tech-week/", "destination": "/blog/lessons-from-london-tech-week-ai", "permanent": true },
    { "source": "/2025/07/03/from-cluj-to-london-what-we-brought-home-from-tech-week", "destination": "/blog/lessons-from-london-tech-week-ai", "permanent": true },
    { "source": "/2025/10/16/employees-level-of-experience-and-impact-on-projects/", "destination": "/blog/senior-engineers-ai-leverage", "permanent": true },
    { "source": "/2025/10/16/employees-level-of-experience-and-impact-on-projects", "destination": "/blog/senior-engineers-ai-leverage", "permanent": true },
    { "source": "/pf/case-study-revote/", "destination": "/case-study/revote", "permanent": true },
    { "source": "/pf/case-study-revote", "destination": "/case-study/revote", "permanent": true },
    { "source": "/home/ourwork/", "destination": "/case-studies", "permanent": true },
    { "source": "/home/ourwork", "destination": "/case-studies", "permanent": true },
    { "source": "/home/", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/category/blog-7code/", "destination": "/blog", "permanent": true },
    { "source": "/category/blog-7code", "destination": "/blog", "permanent": true },
    { "source": "/7code-blog/", "destination": "/blog", "permanent": true },
    { "source": "/7code-blog", "destination": "/blog", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacy-policy", "permanent": true },
    { "source": "/cookie-policy/", "destination": "/privacy-policy#cookies", "permanent": true },
    { "source": "/cookie-policy", "destination": "/privacy-policy#cookies", "permanent": true },
    { "source": "/terms/", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/terms", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug", "destination": "/blog/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/project/(.*)", "destination": "/project/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
